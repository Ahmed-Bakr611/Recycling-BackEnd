{
  "compilerOptions": {
    "module": "CommonJS", // Render expects CommonJS for Node.js
    "target": "ES2020", // Optional, modern JS target
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "src",
    "sourceMap": true,
    "noImplicitAny": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true
  },
  "include": ["src/**/*", "types"]
}
